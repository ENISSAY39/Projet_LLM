# Copier ce fichier en .env (ignoré par Git) et remplir les valeurs.

# Adresse d'Ollama vue depuis le conteneur Open WebUI.
# Laptop (Ollama natif sous Windows) :
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Clé de session d'Open WebUI : fixe, sinon tout le monde est déconnecté à chaque recréation.
# Générer : openssl rand -hex 32
WEBUI_SECRET_KEY=
